{
  "name": "campaigns-app",
  "version": "0.2.0",
  "type": "module",
  "description": "Local markdown campaign planner and execution board.",
  "license": "MIT",
  "author": "Christian Katzmann",
  "homepage": "https://github.com/Christian-Katzmann/Campaigns#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Christian-Katzmann/Campaigns.git"
  },
  "bugs": {
    "url": "https://github.com/Christian-Katzmann/Campaigns/issues"
  },
  "keywords": [
    "campaigns",
    "markdown",
    "planning",
    "ai-coding",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "action/",
    "lib/",
    "public/",
    "schema/",
    "SECURITY.md",
    "docs/campaigns-in-ci.md",
    "docs/spec/campaign-md-v1.md",
    "docs/paste-anywhere-planner.md",
    "docs/run-state-schema.md",
    "docs/runner-api.md",
    "docs/threat-model.md",
    "examples/sample-campaign.md",
    "scripts/action-e2e-harness.mjs",
    "campaigns.config.json",
    "server.mjs"
  ],
  "bin": {
    "campaigns": "bin/campaigns.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:sample": "node server.mjs --file examples/sample-campaign.md",
    "assets:render": "./scripts/render-public-assets.sh",
    "replay:build": "node scripts/build-replay-demo.mjs",
    "check": "find server.mjs lib public bin -type f \\( -name '*.mjs' -o -name 'app.js' \\) -not -path '*/vendor/*' -print0 | xargs -0 -n1 node --check",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "action:e2e": "node scripts/action-e2e-harness.mjs",
    "desktop:icons": "APP_NAME='Campaigns' APP_SLUG='campaigns' ./scripts/desktop-icons.sh",
    "desktop:build": "./scripts/desktop-build.sh",
    "desktop:install": "./scripts/desktop-install.sh",
    "desktop:login-item": "./scripts/desktop-login-item.sh",
    "desktop:quit": "./scripts/desktop-quit.sh",
    "desktop:icons:preview": "APP_NAME='Campaigns' APP_SLUG='campaigns' ./scripts/desktop-icons-preview.sh",
    "desktop:doctor": "./scripts/desktop-doctor.sh"
  }
}
