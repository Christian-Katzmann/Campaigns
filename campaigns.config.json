{
  "schemaVersion": 1,
  "_comment": "Effort names are normalized per runner here because the CLIs use different names: extra-high maps to high for Claude subscriptions and xhigh for Codex.",
  "defaultRunner": "claude",
  "runnerPaths": [],
  "watchdog": {
    "minimum_runtime_ms": 3600000,
    "stall_window_ms": 1200000
  },
  "run": {
    "repoRoot": null,
    "branch": null,
    "max_steps_per_run": 50,
    "max_run_minutes": 360,
    "stop_grace_ms": 3000,
    "max_parallel_steps": 2
  },
  "review": {
    "maxFixAttempts": 2,
    "forceMergeUnreviewed": false
  },
  "runners": {
    "claude": {
      "family": "anthropic",
      "label": "Claude Code",
      "binary": "claude",
      "args": [
        "--effort",
        "{effort}",
        "--print",
        "--permission-mode",
        "bypassPermissions",
        "--model",
        "{model}",
        "--input-format",
        "text",
        "--output-format",
        "stream-json",
        "--verbose"
      ],
      "prompt": {
        "delivery": "stdin"
      },
      "defaults": {
        "model": "claude-opus-4-8",
        "effort": "high"
      },
      "models": [
        {
          "id": "claude-opus-4-8",
          "label": "Fable 5"
        }
      ],
      "efforts": [
        {
          "id": "high",
          "label": "High"
        },
        {
          "id": "medium",
          "label": "Medium"
        },
        {
          "id": "low",
          "label": "Low"
        }
      ],
      "effortMap": {
        "extra-high": "high",
        "xhigh": "high",
        "max": "high",
        "high": "high",
        "medium": "medium",
        "low": "low"
      },
      "environment": {
        "remove": [
          "CLAUDECODE",
          "CLAUDE_CODE_ENTRYPOINT"
        ]
      },
      "completion": {
        "marker": {
          "type": "campaigns.step_completed",
          "version": 1,
          "status": "completed"
        },
        "sources": [
          {
            "kind": "jsonl",
            "match": {
              "type": "result"
            },
            "field": "result"
          }
        ]
      }
    },
    "codex": {
      "family": "openai",
      "label": "Codex",
      "binary": "codex",
      "args": [
        "exec",
        "--ignore-user-config",
        "--json",
        "-C",
        "{repo}",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\"",
        "-c",
        "approval_policy=\"never\"",
        "-s",
        "danger-full-access",
        "-o",
        "{output}",
        "-"
      ],
      "prompt": {
        "delivery": "stdin"
      },
      "defaults": {
        "model": "gpt-5.6-sol",
        "effort": "xhigh"
      },
      "models": [
        {
          "id": "gpt-5.6-sol",
          "label": "GPT-5.6-Sol"
        }
      ],
      "efforts": [
        {
          "id": "xhigh",
          "label": "Extra High"
        },
        {
          "id": "high",
          "label": "High"
        },
        {
          "id": "medium",
          "label": "Medium"
        },
        {
          "id": "low",
          "label": "Low"
        }
      ],
      "effortMap": {
        "extra-high": "xhigh",
        "xhigh": "xhigh",
        "max": "xhigh",
        "high": "high",
        "medium": "medium",
        "low": "low"
      },
      "environment": {
        "remove": []
      },
      "completion": {
        "marker": {
          "type": "campaigns.step_completed",
          "version": 1,
          "status": "completed"
        },
        "sources": [
          {
            "kind": "jsonl",
            "match": {
              "type": "item.completed",
              "item.type": "agent_message"
            },
            "field": "item.text"
          }
        ]
      }
    }
  }
}
