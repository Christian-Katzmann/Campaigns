# Optional local overrides for Campaigns.
# Copy to .env only if your shell or launcher loads env files.

# PORT=4178
# CAMPAIGN_FILE=examples/sample-campaign.md
# CAMPAIGNS_REGISTRY_DIR=/path/to/campaigns-state
# CAMPAIGNS_PORT_FILE=/path/to/server.port

# Campaign Companion pet (Codex custom pet package). By default the companion
# uses the first usable package alphabetically under ${CODEX_HOME:-$HOME/.codex}/pets.
# Set CAMPAIGNS_COMPANION_PET to pin a specific pet by its folder id.
# CAMPAIGNS_COMPANION_PET=kro
# CAMPAIGNS_PETS_DIR=/path/to/pets
