{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Christian-Katzmann/Campaigns/blob/main/schema/run-state.schema.json",
  "title": "Campaigns unified run state",
  "description": "Structural schema for Campaigns run-state version 8. Runtime validation also enforces state-machine and cross-record invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "config",
    "cursor",
    "steps",
    "worker",
    "workers",
    "review",
    "blockers",
    "recovery",
    "rollback",
    "rollbacks",
    "artifacts",
    "history"
  ],
  "properties": {
    "schema_version": { "const": 8 },
    "run": { "$ref": "#/$defs/run" },
    "config": { "$ref": "#/$defs/config" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "worker": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/worker" }
      ]
    },
    "workers": {
      "type": "array",
      "items": { "$ref": "#/$defs/active_worker" }
    },
    "review": { "$ref": "#/$defs/review" },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "recovery": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/recovery" }
      ]
    },
    "rollback": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/rollback" }
      ]
    },
    "rollbacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/rollback" }
    },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/history_entry" }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullable_string": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/non_empty_string" }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullable_timestamp": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/timestamp" }
      ]
    },
    "absolute_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|[\\\\/]{2})"
    },
    "nullable_absolute_path": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/absolute_path" }
      ]
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "run_status": {
      "enum": [
        "pending",
        "running",
        "blocked",
        "failed",
        "awaiting_review",
        "awaiting_human_review",
        "reviewing",
        "reworking",
        "rolling_back",
        "rollback_conflict",
        "recovering",
        "cap_reached",
        "stopped_by_user",
        "halted",
        "completed",
        "merged",
        "force_merged"
      ]
    },
    "run_event": {
      "enum": [
        "run_created",
        "run_started",
        "preflight_dirty_worktree",
        "preflight_branch_unavailable",
        "preflight_campaign_invalid",
        "step_started",
        "check_failed",
        "step_completed",
        "step_skipped",
        "step_failed",
        "parallel_group_demoted",
        "parallel_group_started",
        "parallel_step_merged",
        "parallel_group_joined",
        "run_reached_final_review",
        "reviewer_unavailable",
        "final_review_started",
        "final_review_reasked",
        "final_review_needs_work",
        "final_fix_started",
        "final_fix_failed",
        "review_unparseable",
        "review_fix_attempts_exhausted",
        "review_merge_failed",
        "final_rework_completed",
        "final_review_approved",
        "human_review_approved",
        "final_review_halted",
        "campaign_completed",
        "campaign_merged",
        "force_merged_unreviewed",
        "cap_reached",
        "stopped_by_user",
        "rollback_started",
        "rollback_resumed",
        "rollback_progress",
        "rollback_git_completed",
        "rollback_markdown_completed",
        "rollback_conflicted",
        "rollback_completed",
        "recovery_started",
        "stale_lock_released",
        "step_reset_by_recover",
        "step_continued_by_recover",
        "recovery_completed",
        "recovery_failed"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_path", "repo_root"],
      "properties": {
        "campaign_path": { "$ref": "#/$defs/absolute_path" },
        "repo_root": { "$ref": "#/$defs/absolute_path" }
      }
    },
    "execution_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_path", "repo_root", "branch"],
      "properties": {
        "campaign_path": { "$ref": "#/$defs/absolute_path" },
        "repo_root": { "$ref": "#/$defs/absolute_path" },
        "branch": { "$ref": "#/$defs/non_empty_string" },
        "merge_target_branch": { "$ref": "#/$defs/non_empty_string" },
        "merge_target_repo_root": { "$ref": "#/$defs/absolute_path" }
      },
      "dependentRequired": {
        "merge_target_branch": ["merge_target_repo_root"],
        "merge_target_repo_root": ["merge_target_branch"]
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "source", "execution"],
      "properties": {
        "registry_id": { "$ref": "#/$defs/nullable_string" },
        "source": { "$ref": "#/$defs/location" },
        "execution": { "$ref": "#/$defs/execution_location" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "created_at",
        "updated_at",
        "started_at",
        "ended_at",
        "current_step_id",
        "current_step_ids",
        "identity"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "status": { "$ref": "#/$defs/run_status" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "started_at": { "$ref": "#/$defs/nullable_timestamp" },
        "ended_at": { "$ref": "#/$defs/nullable_timestamp" },
        "current_step_id": { "$ref": "#/$defs/nullable_string" },
        "current_step_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "identity": { "$ref": "#/$defs/identity" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "reviewer",
        "model",
        "effort",
        "watchdog",
        "max_fix_attempts",
        "force_merge_unreviewed",
        "max_steps_per_run",
        "max_run_minutes",
        "stop_grace_ms",
        "max_parallel_steps",
        "worktree_enabled"
      ],
      "properties": {
        "runner": { "$ref": "#/$defs/non_empty_string" },
        "reviewer": { "$ref": "#/$defs/non_empty_string" },
        "model": { "$ref": "#/$defs/nullable_string" },
        "effort": { "$ref": "#/$defs/nullable_string" },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_runtime_ms", "stall_window_ms"],
          "properties": {
            "minimum_runtime_ms": { "type": "integer", "minimum": 0 },
            "stall_window_ms": { "type": "integer", "minimum": 1 }
          }
        },
        "max_fix_attempts": { "type": "integer", "minimum": 1 },
        "force_merge_unreviewed": { "type": "boolean" },
        "max_steps_per_run": { "type": "integer", "minimum": 1 },
        "max_run_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "stop_grace_ms": { "type": "integer", "minimum": 1 },
        "max_parallel_steps": { "type": "integer", "minimum": 1 },
        "worktree_enabled": { "type": "boolean" }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "phase", "attempt"],
      "properties": {
        "step_id": { "$ref": "#/$defs/nullable_string" },
        "phase": { "$ref": "#/$defs/nullable_string" },
        "attempt": { "type": "integer", "minimum": 0 }
      }
    },
    "commit_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_oid", "head_oid"],
      "properties": {
        "base_oid": { "$ref": "#/$defs/git_oid" },
        "head_oid": { "$ref": "#/$defs/git_oid" }
      }
    },
    "parallel_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "step_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "step_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "output_tail"],
      "properties": {
        "code": {
          "enum": [
            "watchdog_stalled",
            "completion_signal_missing",
            "checkout_failed",
            "worker_exit",
            "tool_failure",
            "merge_conflict",
            "branch_creation_failed",
            "environment",
            "unknown"
          ]
        },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "retryable": { "type": "boolean" },
        "output_tail": {
          "type": ["string", "null"]
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_parallel", "sibling_steps"],
      "properties": {
        "is_parallel": { "type": "boolean" },
        "sibling_steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globs"],
      "properties": {
        "globs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "phase",
        "status",
        "attempt",
        "started_at",
        "completed_at",
        "receipt_path",
        "commit_range",
        "parallel_group",
        "runner",
        "model",
        "effort",
        "failure",
        "parallel",
        "lane"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "name": { "$ref": "#/$defs/non_empty_string" },
        "phase": { "$ref": "#/$defs/nullable_string" },
        "status": { "enum": ["pending", "running", "completed", "failed", "stopped", "skipped"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "started_at": { "$ref": "#/$defs/nullable_timestamp" },
        "completed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "receipt_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "commit_range": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/commit_range" }
          ]
        },
        "parallel_group": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/parallel_group" }
          ]
        },
        "runner": { "$ref": "#/$defs/nullable_string" },
        "model": { "$ref": "#/$defs/nullable_string" },
        "effort": { "$ref": "#/$defs/nullable_string" },
        "failure": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/failure" }
          ]
        },
        "parallel": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/parallel" }
          ]
        },
        "lane": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/lane" }
          ]
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "invocation_id",
        "pid",
        "started_at",
        "last_activity_at",
        "log_path",
        "live_output_path"
      ],
      "properties": {
        "runner": { "$ref": "#/$defs/non_empty_string" },
        "invocation_id": { "$ref": "#/$defs/non_empty_string" },
        "pid": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "last_activity_at": { "$ref": "#/$defs/timestamp" },
        "log_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "live_output_path": { "$ref": "#/$defs/nullable_absolute_path" }
      }
    },
    "active_worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "runner",
        "invocation_id",
        "pid",
        "started_at",
        "last_activity_at",
        "log_path",
        "live_output_path"
      ],
      "properties": {
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "runner": { "$ref": "#/$defs/non_empty_string" },
        "invocation_id": { "$ref": "#/$defs/non_empty_string" },
        "pid": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "last_activity_at": { "$ref": "#/$defs/timestamp" },
        "log_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "live_output_path": { "$ref": "#/$defs/nullable_absolute_path" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "paths"],
      "properties": {
        "reason": { "$ref": "#/$defs/non_empty_string" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts",
        "verdict",
        "reasons",
        "raw_tags",
        "findings",
        "review_path",
        "reviewer_runner",
        "reviewer_family",
        "reviewer_ladder_tier"
      ],
      "properties": {
        "status": { "enum": ["not_started", "pending", "running", "needs_work", "awaiting_human", "approved", "halted", "unreviewed"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "verdict": { "$ref": "#/$defs/nullable_string" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "raw_tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "review_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "reviewer_runner": { "$ref": "#/$defs/nullable_string" },
        "reviewer_family": { "$ref": "#/$defs/nullable_string" },
        "reviewer_ladder_tier": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["cross_family", "same_family", "explicit", "human"] }
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event", "message", "created_at", "step_id"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "event": { "enum": ["preflight_dirty_worktree", "preflight_branch_unavailable", "preflight_campaign_invalid"] },
        "message": { "$ref": "#/$defs/non_empty_string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "step_id": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_status", "step_id", "started_at"],
      "properties": {
        "from_status": { "enum": ["pending", "running", "blocked", "failed", "awaiting_review", "halted", "cap_reached", "stopped_by_user"] },
        "step_id": { "$ref": "#/$defs/nullable_string" },
        "started_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "rollback_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "base_oid", "head_oid"],
      "properties": {
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "base_oid": { "$ref": "#/$defs/git_oid" },
        "head_oid": { "$ref": "#/$defs/git_oid" }
      }
    },
    "rollback_commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oid", "mainline", "revert_oid"],
      "properties": {
        "oid": { "$ref": "#/$defs/git_oid" },
        "mainline": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "revert_oid": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/git_oid" }
          ]
        }
      }
    },
    "rollback_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "step_ids", "ranges", "commits"],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "kind": { "enum": ["step", "parallel_group"] },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollback_range" }
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollback_commit" }
        }
      }
    },
    "rollback_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "commit_oid", "message"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/non_empty_string" },
        "commit_oid": { "$ref": "#/$defs/git_oid" },
        "message": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "source_status",
        "to_step_id",
        "boundary_step_id",
        "step_ids",
        "start_oid",
        "published_head",
        "execution_branch",
        "worktree_path",
        "temporary_branch",
        "temporary_worktree_path",
        "operations",
        "started_at",
        "updated_at",
        "markdown_commit_oid",
        "receipt_path",
        "completed_at",
        "conflict"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/non_empty_string" },
        "status": { "enum": ["intent", "git_completed", "markdown_completed", "conflict", "completed"] },
        "source_status": { "$ref": "#/$defs/non_empty_string" },
        "to_step_id": { "$ref": "#/$defs/non_empty_string" },
        "boundary_step_id": { "$ref": "#/$defs/non_empty_string" },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "start_oid": { "$ref": "#/$defs/git_oid" },
        "published_head": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/git_oid" }
          ]
        },
        "execution_branch": { "$ref": "#/$defs/non_empty_string" },
        "worktree_path": { "$ref": "#/$defs/absolute_path" },
        "temporary_branch": { "$ref": "#/$defs/non_empty_string" },
        "temporary_worktree_path": { "$ref": "#/$defs/absolute_path" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/rollback_operation" }
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "markdown_commit_oid": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/git_oid" }
          ]
        },
        "receipt_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "completed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "conflict": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/rollback_conflict" }
          ]
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "base_branch", "created_at", "cleanup_deadline", "pruned_at"],
      "properties": {
        "path": { "$ref": "#/$defs/absolute_path" },
        "branch": { "$ref": "#/$defs/non_empty_string" },
        "base_branch": { "$ref": "#/$defs/non_empty_string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "cleanup_deadline": { "$ref": "#/$defs/nullable_timestamp" },
        "pruned_at": { "$ref": "#/$defs/nullable_timestamp" }
      }
    },
    "parallel_worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "path", "branch", "base_sha", "created_at", "merged_at", "pruned_at"],
      "properties": {
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "path": { "$ref": "#/$defs/absolute_path" },
        "branch": { "$ref": "#/$defs/non_empty_string" },
        "base_sha": { "$ref": "#/$defs/non_empty_string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "merged_at": { "$ref": "#/$defs/nullable_timestamp" },
        "pruned_at": { "$ref": "#/$defs/nullable_timestamp" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_dir", "receipts_dir", "final_review_path", "worktree", "parallel_worktrees"],
      "properties": {
        "run_dir": { "$ref": "#/$defs/absolute_path" },
        "receipts_dir": { "$ref": "#/$defs/absolute_path" },
        "final_review_path": { "$ref": "#/$defs/nullable_absolute_path" },
        "worktree": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/worktree" }
          ]
        },
        "parallel_worktrees": {
          "type": "array",
          "items": { "$ref": "#/$defs/parallel_worktree" }
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "event", "from_status", "to_status", "step_id", "message", "details"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "at": { "$ref": "#/$defs/timestamp" },
        "event": { "$ref": "#/$defs/run_event" },
        "from_status": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/run_status" }
          ]
        },
        "to_status": { "$ref": "#/$defs/run_status" },
        "step_id": { "$ref": "#/$defs/nullable_string" },
        "message": { "$ref": "#/$defs/nullable_string" },
        "details": { "$ref": "#/$defs/event_details" }
      }
    },
    "runner_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "event_details": {
      "type": "object",
      "properties": {
        "usage": { "$ref": "#/$defs/runner_usage" }
      },
      "additionalProperties": true
    },
    "engine_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "at", "run_id", "sequence"],
      "properties": {
        "event": { "$ref": "#/$defs/run_event" },
        "at": { "$ref": "#/$defs/timestamp" },
        "run_id": { "$ref": "#/$defs/non_empty_string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "step_id": { "$ref": "#/$defs/non_empty_string" },
        "details": { "$ref": "#/$defs/event_details" }
      }
    }
  }
}
