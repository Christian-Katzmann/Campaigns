{
  "schemaVersion": 1,
  "id": "gemini",
  "family": "google",
  "label": "Gemini Test",
  "binary": "./fake-gemini.mjs",
  "args": [
    "{prompt}"
  ],
  "prompt": {
    "delivery": "arg"
  },
  "defaults": {
    "model": "gemini-test",
    "effort": "none"
  },
  "models": [
    {
      "id": "gemini-test",
      "label": "Gemini Test"
    }
  ],
  "efforts": [
    {
      "id": "none",
      "label": "None"
    }
  ],
  "effortMap": {
    "none": "none"
  },
  "environment": {
    "remove": []
  },
  "completion": {
    "marker": {
      "type": "campaigns.step_completed",
      "version": 1,
      "status": "completed"
    },
    "sources": [
      {
        "kind": "text"
      }
    ]
  },
  "usage": {
    "sources": [
      {
        "kind": "jsonl",
        "match": {
          "type": "usage"
        },
        "fields": {
          "input_tokens": "metrics.prompt",
          "output_tokens": "metrics.completion",
          "cost_usd": "metrics.cost"
        }
      }
    ]
  }
}
